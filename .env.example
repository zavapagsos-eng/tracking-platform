# ============================================================
# Tracking Platform — Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Runtime ---
TRACKING_ENV=development            # development | staging | production
PORT=3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://tracking:tracking_dev_pw@localhost:5432/tracking_dev

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Gateway security ---
# 32+ byte random secret used to HMAC-sign transfer tokens and internal webhooks.
GATEWAY_HMAC_SECRET=replace-with-64-hex-chars-from-crypto-randomBytes-32
# CORS allowlist (comma separated), e.g. https://store-a.myshopify.com,https://store-b.myshopify.com
CORS_ALLOWLIST=

# --- Cross-domain transfer ---
TRANSFER_TOKEN_TTL_SECONDS=600

# --- Shopify App Proxy ---
# The installed app's OAuth client secret. ONE shared value across every
# store the app is installed on — verified against shopify.dev: App Proxy
# request signing uses the app's single client secret, never a per-shop one
# (see docs/PHASE_LOG.md's "Correção de Arquitetura — Multi-Loja de Destino").
SHOPIFY_APP_PROXY_SECRET=

# --- Shopify store registry (Hub + every destination/checkout store) ---
# A JSON array, one entry per Shopify store this Gateway talks to: the Hub
# storefront (role "storefront") plus each destination/checkout store
# (role "checkout") a product's "buy" click can redirect to. Real topology:
# ONE Hub catalog, MULTIPLE distinct destination stores (each its own
# Shopify store/domain/Shopify Payments account), chosen per-product by
# data already on the product in Shopify (tag/metafield/collection) — see
# apps/gateway/src/config.ts and docs/PHASE_LOG.md's "Correção de
# Arquitetura — Multi-Loja de Destino" for the full design. Each store's
# `webhook_secret` is that store's OWN Admin API webhook signing secret
# (distinct per store, unlike SHOPIFY_APP_PROXY_SECRET above). Add or
# remove destination stores here without touching any other code path.
SHOPIFY_STORES=[{"shop_id":"hub","domain":"hub.myshopify.com","role":"storefront","webhook_secret":"replace-me"},{"shop_id":"loja-destino-1","domain":"loja-destino-1.myshopify.com","role":"checkout","webhook_secret":"replace-me"},{"shop_id":"loja-destino-2","domain":"loja-destino-2.myshopify.com","role":"checkout","webhook_secret":"replace-me"}]

# --- Meta Conversions API ---
# META_DATASET_ID wins when both are set (see apps/gateway/src/config.ts
# for why either name is accepted — Meta's own docs describe the /events
# endpoint's path id as a "dataset id" while Events Manager still labels
# the same numeric id "Pixel ID"; verify which term your own Events
# Manager screen uses when connecting real credentials).
META_PIXEL_ID=
META_DATASET_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_API_VERSION=v23.0

# --- Queue (Phase 11) ---
# Only takes effect when REDIS_URL above is set — queueing fails closed
# (no queue/worker constructed) rather than assuming a default Redis is
# reachable. The worker that actually consumes this queue runs as its own
# process: `npm run worker -w @tracking/gateway` (dev) / `worker:start` (built).
META_QUEUE_ATTEMPTS=5
META_QUEUE_BACKOFF_DELAY_MS=5000
META_QUEUE_BACKOFF_JITTER=0.2

# --- Admin dashboard (Phase 13) ---
# HTTP Basic Auth against a single operator account — every /admin/* route
# fails closed (401) until BOTH are set. ADMIN_DASHBOARD_PASSWORD_HASH is a
# bcrypt hash (e.g. `node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"`),
# NEVER a plaintext password.
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD_HASH=

# --- Reconciliation Engine (Phase 12) ---
# Standard 5-field cron expression, read by the standalone process
# `npm run reconciliation -w @tracking/gateway` (dev) / `reconciliation:start`
# (built) — never by the HTTP Gateway itself. Runs even without REDIS_URL
# (scan-only, no auto-requeue in that case).
RECONCILIATION_CRON=*/30 * * * *
# A PAID order with nothing attempted yet and no dead-letter row is only
# flagged MISSING_META once it's been paid longer than this many minutes —
# avoids false alarms on an order that's simply still queued.
RECONCILIATION_STALE_AFTER_MINUTES=15
# Bounded auto-requeue: never more than this many attempts per order...
RECONCILIATION_MAX_REQUEUE_ATTEMPTS=5
# ...and never sooner than this many minutes since its last failure.
RECONCILIATION_REQUEUE_COOLDOWN_MINUTES=60
