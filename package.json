{
  "name": "tracking-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Server-side first-party tracking platform: Meta Ads + Shopify Store A/B + Shopify Payments",
  "workspaces": [
    "packages/*",
    "apps/*",
    "extensions/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @tracking/db",
    "db:migrate": "npm run db:migrate -w @tracking/db"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
